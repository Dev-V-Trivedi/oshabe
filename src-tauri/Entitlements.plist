<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>com.apple.security.device.microphone</key>
    <true/>
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <!-- Tauri signs the main binary with the Hardened Runtime option,
         which enforces library validation by default: a bundled framework
         must be signed by Apple or by this app's own Team ID, and an
         ad-hoc signature (no Team ID, the unsigned SIGN_BINARIES=false
         build path) never satisfies that even against another ad-hoc
         signature. The bundled libonnxruntime dylib (x86_64 macOS) fails
         to load without this, aborting at launch. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
  </dict>
</plist>